<jasperReport name="ReporteGastos" language="java" columnCount="1" pageWidth="975" pageHeight="1000" orientation="Landscape" whenNoDataType="NoDataSection" columnWidth="935" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="7eb46a84-7b7e-4d44-851e-9246e0067ceb">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="LaCocinaDeEmilia"/>
	<style name="Title" fontName="Arial" fontSize="50.0"/>
	<style name="SubTitle" fontName="Arial" fontSize="18.0"/>
	<style name="Column header" fontName="Arial" fontSize="14.0" bold="true"/>
	<style name="Detail" mode="Transparent" fontName="Arial"/>
	<style name="Row" mode="Transparent" fontName="Arial">
		<conditionalStyle backcolor="#F0EFEF">
			<conditionExpression><![CDATA[$V{REPORT_COUNT}%2 == 0]]></conditionExpression>
		</conditionalStyle>
	</style>
	<parameter name="fechaInicio" class="java.sql.Date"/>
	<parameter name="fechaFin" class="java.sql.Date"/>
	<query language="SQL"><![CDATA[
        
        SELECT g.id AS ID, 
               g.descripcion AS DESCRIPCION, 
               g.monto AS MONTO, 
               g.fecha AS FECHA, 
               g.fecha_carga AS FECHA_CARGA 
        FROM aplicacion.gastos g
        WHERE g.fecha >= $P{fechaInicio} AND g.fecha <= $P{fechaFin}
        ORDER BY id ASC
        
    ]]></query>
	<field name="id" class="java.lang.Integer"/>
	<field name="descripcion" class="java.lang.String"/>
	<field name="monto" class="java.math.BigDecimal"/>
	<field name="fecha" class="java.sql.Date"/>
	<field name="fecha_carga" class="java.sql.Timestamp"/>
	<variable name="SUM_MONTO" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{monto}]]></expression>
	</variable>
