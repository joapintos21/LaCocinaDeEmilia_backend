	<query language="SQL"><![CDATA[SELECT u.id AS ID, 
			  u.email AS EMAIL, 
			  u.nombre AS NOMBRE, 
			  u.telefono AS TELEFONO, 
			  d.direccion AS DIRECCION,
			  r.nombre AS ROL, 
			  u.status AS STATUS 
FROM gestion_usuarios.usuario u 
LEFT JOIN gestion_usuarios.rol as r on r.id = u.rol_id 
LEFT JOIN gestion_usuarios.cliente as c on c.usuario_id = u.id
LEFT JOIN aplicacion.direccion as d on d.cliente_id = c.id
ORDER BY id ASC]]></query>
