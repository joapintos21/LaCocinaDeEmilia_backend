	<query language="SQL"><![CDATA[SELECT u.id AS ID, u.email AS EMAIL, u.nombre AS NOMBRE, u.telefono AS TELEFONO, r.nombre AS ROL, u.status AS STATUS 
FROM gestion_usuarios.usuario u 
LEFT JOIN gestion_usuarios.rol as r on r.id = u.rol_id
ORDER BY id ASC ]]></query>
