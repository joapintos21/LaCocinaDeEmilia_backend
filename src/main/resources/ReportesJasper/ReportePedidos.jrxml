	<parameter name="fechaInicio" class="java.sql.Date"/>
	<parameter name="fechaFin" class="java.sql.Date"/>
	<query language="SQL"><![CDATA[select id, 
			nombre_cliente, 
			telefono, 
			direccion, 
			barrio, 
			fecha_creacion, 
			metodo_de_pago, 
			estado_pago, 
			total, 
			estado_pedido, 
			nombre_cocinera, 
			nombre_cadete, 
			fecha_entrega, 
			detalles_pedido
from aplicacion.vista_pedidos_detalles
WHERE fecha_creacion >= $P{fechaInicio} AND fecha_creacion <= $P{fechaFin}]]></query>
