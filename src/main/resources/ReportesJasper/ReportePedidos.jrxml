	<parameter name="fechaInicio" class="java.sql.Date"/>
	<parameter name="fechaFin" class="java.sql.Date"/>
	<query language="SQL"><![CDATA[SELECT VPD.id, 
			  VPD.nombre_cliente, 
			  VPD.telefono, 
			  VPD.direccion, 
			  VPD.barrio, 
			  VPD.fecha_creacion, 
			  VPD.metodo_de_pago, 
			  VPD.estado_pago, total, 
			  VPD.estado_pedido, 
              VPD.nombre_cocinera, 
              VPD.nombre_cadete, 
              VPD.fecha_entrega, 
              VPD.detalles_pedido
 FROM aplicacion.vista_pedidos_detalles VPD
 WHERE VPD.fecha_creacion >= $P{fechaInicio} AND VPD.fecha_creacion <= $P{fechaFin}
        ORDER BY id ASC]]></query>
